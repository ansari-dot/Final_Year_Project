# ===== ReWearX – root .gitignore =====

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/install-state.gz

# Build outputs
dist/
build/
out/
**/dist/
**/build/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Logs
logs/
*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploads (user-generated, never commit)
uploads/
**/uploads/
!**/uploads/.gitkeep

# Coverage / test reports
coverage/
*.lcov
.nyc_output/

# Caches
.cache/
.parcel-cache/
.vite/
.turbo/
.next/
.nuxt/
.eslintcache
.stylelintcache

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Misc
*.bak
*.tmp
*.pid
*.pid.lock
*.seed
