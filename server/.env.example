# ============================================
# ReWearX Backend Environment Variables
# ============================================

# Server
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Frontend URLs (CORS whitelist – comma-separated)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rewearx
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace_this_with_another_long_random_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rewearx

# Email (SendGrid SMTP or any SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=apikey
EMAIL_PASSWORD=
EMAIL_FROM=ReWearX <no-reply@rewearx.com>

# Rate limit (window in ms / max requests). Limits are skipped when NODE_ENV=development.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=50

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_IMAGES_PER_ITEM=5

# FastAPI AI service (optional – not required for this Node.js-only backend)
FASTAPI_URL=http://localhost:8000
FASTAPI_TIMEOUT_MS=10000

# Flask AI/NLP service
AI_SERVICE_URL=http://localhost:5000
